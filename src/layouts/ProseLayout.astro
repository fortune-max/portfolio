---
import BaseLayout from './BaseLayout.astro';
import MonoLabel from '../components/MonoLabel.astro';
import '../styles/prose.css';

interface Props { title: string; description: string; label: string; meta: string; ogImage?: string }
const { title, description, label, meta, ogImage } = Astro.props;
---
<BaseLayout title={title} description={description} ogImage={ogImage}>
  <header class="head tone-dark">
    <div class="wrap">
      <slot name="back" />
      <MonoLabel text={label} />
      <h1 class="display title">{title}</h1>
      <slot name="header" />
      <p class="mono meta">{meta}</p>
    </div>
  </header>
  <div class="body tone-dark">
    <div class="wrap layout">
      <article class="prose"><slot /></article>
      <slot name="aside" />
    </div>
    <div class="wrap"><slot name="footer" /></div>
  </div>
</BaseLayout>
<style>
  .head { background: var(--bg); color: var(--fg); padding-block: clamp(2rem, 6vw, 5rem) 2.5rem; border-bottom: 1px solid var(--rule); }
  .title { font-size: var(--step-4); margin: 0 0 1rem; }
  .meta { color: var(--muted); margin: 1.25rem 0 0; }
  .body { background: var(--bg); color: var(--fg); padding-block: 3rem 5rem; }
  .layout { display: grid; grid-template-columns: minmax(0, 1fr) 17rem; gap: 3rem; align-items: start; }
  @media (max-width: 960px) { .layout { grid-template-columns: minmax(0, 1fr); } }
</style>
