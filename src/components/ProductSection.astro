---
import type { CollectionEntry } from 'astro:content';
import Band from './Band.astro';
import MonoLabel from './MonoLabel.astro';
import Pill from './Pill.astro';
import MetricsCard from './MetricsCard.astro';
import Headline from './Headline.astro';

interface Props { entry: CollectionEntry<'work'>; index: number; tone: 'dark' | 'light' }
const { entry, index, tone } = Astro.props;
const d = entry.data;
---
<Band tone={tone} data-product={entry.id}>
  <div class="wrap grid">
    <div>
      <MonoLabel index={index} text={d.label} />
      <h2 class="display h"><a href={`/work/${entry.id}`}><Headline text={d.headline} strike={d.strike} /></a></h2>
      <p class="summary">{d.summary}</p>
      <ul class="pills">{d.stack.slice(0, 5).map((s) => <Pill text={s} />)}</ul>
      <p class="mono more"><a href={`/work/${entry.id}`}>How I built it →</a></p>
    </div>
    <MetricsCard metrics={d.metrics} />
  </div>
</Band>
<style>
  .grid { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); gap: 2.5rem; align-items: center; }
  @media (max-width: 720px) { .grid { grid-template-columns: minmax(0, 1fr); gap: 1.75rem; } }
  .h { font-size: var(--step-3); margin: 0 0 1rem; }
  .h a { text-decoration: none; }
  .summary { max-width: 36rem; margin: 0 0 1.25rem; color: color-mix(in srgb, var(--fg) 85%, var(--bg)); }
  .pills { display: flex; flex-wrap: wrap; gap: .4rem; padding: 0; margin: 0 0 1.25rem; }
  .more { margin: 0; letter-spacing: .08em; }
  .more a { color: var(--accent); }
</style>
