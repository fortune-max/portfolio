---
const year = new Date().getFullYear();
---
<footer class="site-footer tone-dark">
  <div class="wrap">
    <p class="display sign">Let's build something <em>boring to run</em>.</p>
    <ul class="mono links">
      <li><a href="https://github.com/fortune-max">GitHub</a></li>
      <li><a href="https://www.linkedin.com/in/fortune-max-eguakun/">LinkedIn</a></li>
      <li><a href="/contact">Contact</a></li>
      <li><a href="/cv/Fortune-Max-Eguakun-CV.pdf" download>Download CV</a></li>
    </ul>
    <p class="mono small">© {year} Fortune Max-Eguakun · Barcelona</p>
  </div>
</footer>
<style>
  .site-footer { background: var(--bg); color: var(--fg); padding-block: 4rem 2rem; border-top: 1px solid var(--rule); }
  .sign { font-size: var(--step-3); margin: 0 0 2rem; }
  em { color: var(--accent); font-style: normal; }
  .links { display: flex; flex-wrap: wrap; gap: .5rem 1.5rem; padding: 0; margin: 0 0 2rem; list-style: none; letter-spacing: .1em; text-transform: uppercase; }
  .small { color: var(--muted); }
</style>
