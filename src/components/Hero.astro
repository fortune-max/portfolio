---
import { Image } from 'astro:assets';
import atWork from '../assets/photos/at-work.jpg';
---
<section class="hero tone-dark">
  <div class="wrap grid">
    <div>
      <h1 class="mono name">Fortune Max-Eguakun</h1>
      <p class="display headline" data-hero-headline>I make messy, live systems <em>boring to run</em>.</p>
      <p class="lede">Senior full-stack engineer in Barcelona. I've been building things since I was 14, starting with games for my friends in the school computer lab. These days it's the platform about 450 investors use to back startups. <a href="/about">More about me</a>.</p>
      <p class="mono cta"><a href="#work">See what I've shipped ↓</a> <a href="/contact">Say hi ↗</a></p>
    </div>
    <Image class="photo" src={atWork} alt="Fortune at work, going through code on a laptop with a colleague" widths={[340, 680]} sizes="(max-width: 820px) 90vw, 340px" loading="eager" data-hero-photo />
  </div>
</section>
<style>
  .hero { background: var(--bg); color: var(--fg); padding-block: clamp(2.5rem, 7vw, 6rem) clamp(3rem, 8vw, 7rem); }
  .grid { display: grid; grid-template-columns: minmax(0, 1fr) 340px; gap: 3rem; align-items: center; }
  .photo { width: 100%; height: auto; aspect-ratio: 4 / 5; object-fit: cover; border-radius: 8px; display: block; }
  @media (max-width: 820px) {
    .grid { grid-template-columns: minmax(0, 1fr); gap: 2rem; }
    .photo { max-width: 420px; }
  }
  .name { margin: 0 0 1.5rem; font-size: var(--step--1); font-weight: 600; letter-spacing: .14em; text-transform: uppercase; color: var(--muted); }
  .headline { font-size: var(--step-4); margin: 0 0 1.5rem; max-width: 14ch; }
  em { font-style: normal; color: var(--accent); }
  .lede { max-width: 38rem; font-size: var(--step-1); color: color-mix(in srgb, var(--fg) 85%, var(--bg)); margin: 0 0 2rem; }
  .cta { display: flex; flex-wrap: wrap; gap: 1.5rem; letter-spacing: .08em; }
  .cta a:first-child { color: var(--accent); }
</style>
