---
import Diagram from './Diagram.astro';
---
<Diagram title="AI reporting pipeline" caption="The schema is built at runtime from last quarter's KPIs, so the model can only answer the questions that matter, and every figure must cite its source." viewBox="0 0 720 200">
  <rect class="box" x="20" y="60" width="140" height="80" rx="8" /><text x="38" y="94">founder deck</text><text class="small" x="38" y="116">PDF / slides</text>
  <rect class="box hi" x="200" y="20" width="160" height="70" rx="8" /><text class="hi" x="218" y="50">schema builder</text><text class="small" x="218" y="72">1 field per KPI</text>
  <rect class="box" x="200" y="110" width="160" height="70" rx="8" /><text x="218" y="140">LLM extraction</text><text class="small" x="218" y="162">value + citation</text>
  <rect class="box" x="400" y="60" width="140" height="80" rx="8" /><text x="418" y="94">validation</text><text class="small" x="418" y="116">types + sources</text>
  <rect class="box hi" x="580" y="60" width="120" height="80" rx="8" /><text class="hi" x="598" y="94">draft report</text><text class="small" x="598" y="116">human review</text>
  <path class="edge" d="M160 100 L196 140" /><path class="edge hi" d="M280 90 L280 106" /><path class="edge" d="M360 145 L396 110" /><path class="edge hi" d="M540 100 L576 100" />
</Diagram>
