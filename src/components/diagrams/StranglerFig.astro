---
import Diagram from './Diagram.astro';
---
<Diagram title="Strangler-fig rewrite" caption="New frontends first, on the old API. Then a new backend and schema, filled by an ETL script from production backups and checked against the old system. The final cut-over was one more run of that script." viewBox="0 0 720 300">
  <rect class="box old" x="20" y="40" width="170" height="70" rx="8" /><text x="36" y="70">old backend</text><text class="small" x="36" y="92">Django + MySQL</text>
  <rect class="box hi" x="275" y="40" width="170" height="70" rx="8" /><text class="hi" x="291" y="70">new frontends</text><text class="small" x="291" y="92">admin + investor apps</text>
  <rect class="box hi" x="530" y="40" width="170" height="70" rx="8" /><text class="hi" x="546" y="70">new backend</text><text class="small" x="546" y="92">new schema, Postgres</text>
  <rect class="box" x="210" y="200" width="300" height="70" rx="8" /><text x="300" y="230">ETL script</text><text class="small" x="238" y="252">old backup in, new database out</text>
  <path class="edge" d="M271 75 L194 75" /><text class="small" x="232" y="64" text-anchor="middle">phase 1</text>
  <path class="edge hi" d="M449 75 L526 75" /><text class="small" x="487" y="64" text-anchor="middle">phase 2</text>
  <path class="edge" d="M105 112 L300 196" /><path class="edge hi" d="M420 196 L615 112" />
</Diagram>
