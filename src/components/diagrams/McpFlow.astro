  <rect class="box hi" x="240" y="40" width="240" height="140" rx="8" /><text class="hi" x="260" y="70">MCP server</text>
  <text class="small" x="260" y="96">· 2 GraphQL tools</text><text class="small" x="260" y="116">· schema guide</text><text class="small" x="260" y="136">· search + readers</text><text class="small" x="260" y="156">· read-only</text>
  <rect class="box" x="550" y="70" width="150" height="80" rx="8" /><text x="570" y="100">GraphQL API</text><text class="small" x="570" y="120">read-only</text><text class="small" x="570" y="138">row cap + timeout</text>
